\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces Atomic structures of hydrogen-passivated planar SiC quantum dots containing a single substitutional Cu atom. Panels (a)--(c) correspond to the Cu$_\mathrm  {C}$ configurations, where Cu replaces a carbon atom at positions P$_{1}$ (central site), P$_{2}$ (intermediate site), and P$_{3}$ (edge site), respectively. Panels (d)--(f) show the analogous Cu$_\mathrm  {Si}$ configurations, where Cu substitutes a silicon atom at the same positions. Copper, silicon, carbon, and hydrogen atoms are represented by red, yellow, gray, and white spheres, respectively.}}{}{}\protected@file@percent }
\newlabel{fig:SiC_QDs}{{1}{}{}{figure.1}{}}
\@writefile{toc}{\contentsline {section}{\numberline {3}Results and Discussion}{}{}\protected@file@percent }
\citation{FluorescentSiCNPs,Beke2012Bioimaging}
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Spin-polarized electronic energy levels of hydrogen-passivated planar SiC quantum dots doped with Cu. Panels (a) and (b) correspond to the $\mathrm  {Cu_{C}}$ configuration (Cu substituting a carbon atom) for the spin-up and spin-down channels, respectively. Panels (c) and (d) show the corresponding energy levels for the $\mathrm  {Cu_{Si}}$ configuration (Cu substituting a silicon atom). The figure illustrates the spin splitting and the modification of the frontier electronic states induced by the Cu dopant depending on the substitutional site.}}{}{}\protected@file@percent }
\newlabel{fig:SiC_QDs}{{2}{}{}{figure.2}{}}
\citation{Masashi_2011}
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Spin-resolved HOMO and LUMO energy levels of hydrogen-passivated planar SiC quantum dots doped with Cu. Panels (a) and (b) correspond to the $\mathrm  {Cu_{C}}$ configuration (Cu substituting a carbon atom) for the spin-up and spin-down channels, respectively. Panels (c) and (d) show the corresponding HOMO and LUMO energy levels for the $\mathrm  {Cu_{Si}}$ configuration (Cu substituting a silicon atom). The figure highlights the spin-dependent shifts of the frontier energy levels induced by the Cu dopant.}}{}{}\protected@file@percent }
\newlabel{fig:homo_lumo_levels}{{3}{}{}{figure.3}{}}

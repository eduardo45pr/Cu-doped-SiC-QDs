\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces Cohesive energy of hydrogen-passivated planar SiC quantum dots doped with Cu for the different substitutional configurations considered in this work. The results provide information about the relative stability of the doped systems and reveal the effect of the Cu substitution site on the structural stability of the planar SiC quantum dots.}}{}{}\protected@file@percent }
\newlabel{fig:SiC_QDs}{{4}{}{}{figure.4}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces Spin-resolved dielectric function of hydrogen-passivated planar SiC quantum dots doped with Cu in the $\mathrm  {Cu_{C}}$ configuration. The top panels show the real part ($\varepsilon _1$), and the bottom panels show the imaginary part ($\varepsilon _2$). The left column corresponds to the spin-up channel, while the right column corresponds to the spin-down channel. Different curves represent Cu located at different positions (P$_{1}$, P$_{2}$, and P$_{3}$).}}{}{}\protected@file@percent }
\newlabel{fig:SiC_QDs}{{5}{}{}{figure.5}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces Spin-resolved dielectric function of hydrogen-passivated planar SiC quantum dots doped with Cu in the $\mathrm  {Cu_{Si}}$ configuration. The top panels show the real part ($\varepsilon _1$), and the bottom panels show the imaginary part ($\varepsilon _2$). The left column corresponds to the spin-up channel, while the right column corresponds to the spin-down channel. Different curves represent Cu located at different ring positions (P$_{1}$, P$_{2}$, and P$_{3}$).}}{}{}\protected@file@percent }
\newlabel{fig:SiC_QDs}{{6}{}{}{figure.6}{}}

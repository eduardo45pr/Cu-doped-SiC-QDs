Denchar.TypeOfRun           3D 
Denchar.PlotCharge         .true.
Denchar.PlotWaveFunctions  .true.
Denchar.CoorUnits      Ang            # Format for coordinate of the points
                                       #Bohr
                                       #Ang
Denchar.DensityUnits   Ele/Ang**3     # Units of Charge Density
                                       #Ele/bohr**3
                                       #Ele/Ang**3
                                       #Ele/UnitCell
Denchar.MinX             0  Ang   # Minimum coord of the window in X-dir
Denchar.MaxX            50.0  Ang   # Maximum coord of the window in X-dir
Denchar.MinY             0  Ang   # Minimum coord of the window in Y-dir
Denchar.MaxY            50.0  Ang   # Maximum coord of the window in Y-dir
Denchar.MinZ             0  Ang   # Minimum coord of the window in Y-dir
Denchar.MaxZ            10.0  Ang   # Maximum coord of the window in Y-dir
Denchar.NumberPointsX    40         # Number of points in X-axis
Denchar.NumberPointsY    40         # Number of points in Y-axis
Denchar.NumberPointsZ    40
Denchar.PlaneGeneration  NormalVector      # Option to generate the plane
                                              #NormalVector
                                              #TwoLine
                                              #ThreePoints
                                              #ThreeAtomicIndices
%block Denchar.CompNormalVector               # Indices of three atoms
0.0000    0.0000    1.0000
%endblock Denchar.CompNormalVector

%block Denchar.PlaneOrigin                
0.0000    0.0000    0.0000
%endblock Denchar.PlaneOrigin

%block Denchar.X-Axis                
1.0000    0.0000    0.0000
%endblock Denchar.X-Axis

%block Denchar.y-Axis                
-0.5000    0.8660    0.0000
%endblock Denchar.y-Axis














